# Pantry — copy to .env.local and fill in.
#
# All three are OPTIONAL. With none of them the app runs exactly as designed:
# everything local, nothing sent anywhere. They only turn on the parts that
# need a server.

# Accounts, cloud sync, price reporting, saved plans.
# Project → Settings → API. The publishable/anon key is safe in the client;
# it is the service_role key that must never appear here.
VITE_SUPABASE_URL=https://iokudugeqfwjtifomyis.supabase.co
VITE_SUPABASE_ANON_KEY=

# Web Push, for the leftover nudge. Generate a pair with:
#   npx web-push generate-vapid-keys
# The public half goes here; the private half goes to the edge function:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
