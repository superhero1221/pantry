# Netlify headers. Kept in step with vercel.json — change one, change the other.

# Security headers, on everything.
#
# The CSP is one line because _headers has no continuation syntax. Read in
# order, it says:
#
#   script-src 'self'        dist/index.html has no inline <script> — Vite
#                            emits a module tag and a modulepreload link, and
#                            the preload polyfill compiles into the entry
#                            chunk. So no nonce and no hash is needed.
#   style-src-attr           THE ONE THAT MATTERS. css() returns a React style
#     'unsafe-inline'        prop, so every screen is built out of inline style
#                            ATTRIBUTES, and CSP Level 3 governs those with
#                            style-src-attr. Setting only style-src 'self'
#                            would strip the styling off the entire app,
#                            because style-src is the fallback for it.
#   style-src-elem 'self'    <style> and <link rel=stylesheet> stay locked to
#                            this origin — the loosening above buys attributes
#                            only, not elements.
#   style-src 'self'         For browsers too old for the granular pair
#     'unsafe-inline'        (Safari before 15.4). They degrade to a weaker
#                            policy rather than to an unstyled page.
#   img-src data: blob:      data: for the standalone build's inlined icon and
#                            photographs, blob: for the plate photo, which is
#                            an object URL and is never uploaded anywhere.
#   font-src 'self' data:    public/fonts here, inlined woff2 in standalone.
#   connect-src              The five hosts the app really calls, and the
#                            Supabase project when one is configured. No wss:
#                            — nothing calls db.channel(), so realtime never
#                            opens a socket. Add wss://*.supabase.co the day
#                            something subscribes, and not before.
#   form-action 'none'       There is not one <form> in src/.
#
# The single-file build (scripts/build-standalone.mjs) inlines the bundle and
# the stylesheet into the document. No CSP worth having will run it. It is a
# file:// artefact — hand it over as a file, do not host it under this policy.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; manifest-src 'self'; worker-src 'self'; connect-src 'self' https://api.frankfurter.app https://nominatim.openstreetmap.org https://overpass-api.de https://prices.openfoodfacts.org https://world.openfoodfacts.org https://*.supabase.co; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), display-capture=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  tdm-reservation: 1
  X-Robots-Tag: noai, noimageai

# The last two are the text-and-data-mining reservation, and they sit in this
# block rather than a second `/*` one because a header file is easier to get
# wrong twice than once.
#
# This is the one opt-out with legal weight rather than only conventional
# weight. Article 4 of the EU copyright directive permits mining of lawfully
# accessible works *unless the rightsholder has expressly reserved the right in
# a machine-readable way*. So the reservation is what turns a permitted use
# into an infringing one, and its absence is what turns silence into consent.
#
# W3C's TDM Reservation Protocol says how to express it: `tdm-reservation: 1`
# on the response, and /.well-known/tdmrep.json for a crawler that reads files
# rather than headers. Both ship, because either is a legitimate place to look
# and neither is guaranteed to be the one that gets checked.
#
# robots.txt does a different job. That one asks named crawlers not to fetch;
# this says what may be done with what was fetched, including by whoever
# ignored the asking. X-Robots-Tag: noai is the weakest of the three — a
# convention with no standards body behind it — and is here because it costs
# eighteen bytes.

# Geolocation stays allowed: it is the feature. Camera is denied and the plate
# photo still works — PlateDrop is <input type="file" accept="image/*"> with no
# capture attribute, and a file picker's "Take Photo" is a native OS flow that
# Permissions-Policy does not gate. Nothing in src/ calls getUserMedia.

# The worker decides when everything else updates, so it must never be the
# stale thing. It calls skipWaiting(), and its VERSION does not change between
# deploys, so it takes over the moment the browser sees bytes that differ — a
# cached copy is the one thing that can hold the app on an old build.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# The licence is emitted into dist/ by a plugin in vite.config.ts so that the
# <link rel="license"> in index.html resolves. It has no file extension, so
# without this it goes out as application/octet-stream and downloads instead of
# opening — and a licence that arrives as a mystery file in somebody's
# Downloads folder is one nobody reads.
/LICENSE
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Without this the manifest goes out as application/octet-stream, and a
# manifest served as a download is a manifest the installer ignores.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache

# Content-hashed by the build, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

# same-site, not same-origin, so the apex and www both keep working. This does
# not stop anyone copying a photograph; it stops another site using it from
# your server, which is the only part a header can reach.
/pix/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site
